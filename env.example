# Environment Variables for EduFriend Document Analyzer Backend
PORT=5000
NODE_ENV=production

# OpenAI API Key for AI Analysis & Document Chat
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Frontend URL allowed for CORS (use * for open access or your production domain)
FRONTEND_URL=*

# Upload limits (in Megabytes)
MAX_FILE_SIZE_MB=25
